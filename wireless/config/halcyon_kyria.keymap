#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define GAME 1
#define GFN 2
#define SYM 3
#define NAV 4
#define NUM 5
#define ALT 6
#define CMD 7

/* Match the original timer-free one-shot modifiers as closely as ZMK allows. */
&sk {
    release-after-ms = <60000>;
    lazy;
    quick-release;
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        num_layer {
            if-layers = <SYM NAV>;
            then-layer = <NUM>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
                &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC
                &kp ESC  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &none
                &none  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp F13  &none  &none  &none  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &none
                &kp LGUI  &kp CAPS  &kp SPACE  &mo NAV  &mo ALT  &kp CAPS  &mo SYM  &kp LSHFT  &mo ALT  &kp RGUI
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        game_layer {
            display-name = "GAME";
            bindings = <
                &none  &kp TAB  &kp Q  &kp W  &kp E  &kp R  &none  &none  &kp UP  &none  &kp TAB  &none
                &none  &kp LSHFT  &kp A  &kp S  &kp D  &kp F  &none  &kp LEFT  &kp DOWN  &kp RIGHT  &kp RSHFT  &none
                &none  &kp LCTRL  &kp Z  &kp X  &kp C  &kp V  &none  &none  &none  &none  &none  &none  &none  &none  &kp RCTRL  &none
                &none  &kp LALT  &kp SPACE  &mo GFN  &none  &none  &to BASE  &kp SPACE  &kp PSCRN  &none
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        gfn_layer {
            display-name = "GFN";
            bindings = <
                &none  &kp N5  &kp N1  &kp N2  &kp N3  &kp N4  &kp KP_NUM  &none  &none  &none  &none  &none
                &none  &kp N0  &kp N6  &kp N7  &kp N8  &kp N9  &none  &none  &none  &none  &none  &none
                &none  &kp G  &kp J  &kp I  &kp M  &kp T  &none  &none  &none  &none  &none  &none  &none  &sys_reset  &bootloader  &none
                &none  &kp ESC  &kp RET  &trans  &none  &none  &trans  &trans  &trans  &none
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        sym_layer {
            display-name = "SYM";
            bindings = <
                &none  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp BSPC
                &none  &kp SEMI  &kp RA(GRAVE)  &kp GRAVE  &kp LS(GRAVE)  &kp MINUS  &kp PLUS  &sk LSHFT  &sk LCTRL  &sk LALT  &sk LGUI  &none
                &none  &kp RA(BSLH)  &kp LS(RA(BSLH))  &kp LS(LBKT)  &kp LBKT  &kp UNDER  &none  &none  &none  &none  &kp EQUAL  &kp RBKT  &kp LS(RBKT)  &kp LS(BSLH)  &kp BSLH  &none
                &none  &trans  &trans  &trans  &none  &none  &trans  &trans  &trans  &none
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
                &none  &kp LC(TAB)  &kp LG(GRAVE)  &kp LC(LS(TAB))  &kp LC(TAB)  &kp ESC  &kp ESC  &kp HOME  &kp END  &kp BSPC  &kp DEL  &none
                &none  &sk LGUI  &sk LALT  &sk LCTRL  &sk LSHFT  &kp RET  &kp RET  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &none
                &none  &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &to GAME  &kp PSCRN  &kp TAB  &none  &none  &none  &none  &kp TAB  &kp PG_UP  &kp PG_DN  &kp SQT  &kp KP_NUM  &none
                &none  &mo CMD  &trans  &trans  &none  &none  &trans  &trans  &trans  &none
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
                &none  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_N0  &kp BSPC
                &none  &sk LGUI  &sk LALT  &sk LCTRL  &sk LSHFT  &kp F11  &kp F12  &sk LSHFT  &sk LCTRL  &sk LALT  &sk LGUI  &none
                &none  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &none  &none  &none  &none  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &none
                &none  &trans  &trans  &trans  &none  &none  &trans  &trans  &trans  &none
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        alt_layer {
            display-name = "ALT";
            bindings = <
                &none  &kp RA(Q)  &kp RA(W)  &kp RA(E)  &kp RA(R)  &kp RA(T)  &kp RA(Y)  &kp RA(U)  &kp RA(I)  &kp RA(O)  &kp RA(P)  &none
                &none  &kp RA(A)  &kp RA(S)  &kp RA(D)  &kp RA(F)  &kp RA(G)  &kp RA(H)  &kp RA(J)  &kp RA(K)  &kp RA(L)  &kp RA(SEMI)  &none
                &none  &kp RA(Z)  &kp RA(X)  &kp RA(C)  &kp RA(V)  &kp RA(B)  &none  &none  &none  &none  &kp RA(N)  &kp RA(M)  &kp RA(COMMA)  &kp RA(DOT)  &kp RA(FSLH)  &none
                &none  &trans  &kp RA(SPACE)  &kp LSHFT  &none  &none  &trans  &trans  &trans  &none
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        cmd_layer {
            display-name = "CMD";
            bindings = <
                &studio_unlock  &kp LC(LS(LA(Q)))  &kp LC(LS(LA(W)))  &kp LC(LS(LA(E)))  &kp LC(LS(LA(R)))  &kp LC(LS(LA(T)))  &kp LC(LS(LA(Y)))  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &kp LC(LS(LA(P)))  &none
                &none  &kp LC(LS(LA(A)))  &kp LC(LS(LA(S)))  &kp LC(LS(LA(D)))  &kp LC(LS(LA(F)))  &kp LC(LS(LA(G)))  &kp LC(LS(LA(H)))  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp LC(LS(LA(SEMI)))  &none
                &none  &kp LC(LS(LA(Z)))  &kp LC(LS(LA(X)))  &kp LC(LS(LA(C)))  &kp LC(LS(LA(V)))  &kp LC(LS(LA(B)))  &none  &none  &none  &none  &kp LC(LS(LA(N)))  &kp LC(LS(LA(M)))  &kp LC(LS(LA(COMMA)))  &kp LC(LS(LA(DOT)))  &kp LC(LS(LA(FSLH)))  &none
                &none  &trans  &trans  &trans  &none  &none  &kp LGUI  &trans  &trans  &none
                &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

    };
};
